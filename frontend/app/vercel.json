{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm ci || npm install",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/health",
      "destination": "https://aicte-compliance-backend-live.vercel.app/health"
    },
    {
      "source": "/version",
      "destination": "https://aicte-compliance-backend-live.vercel.app/version"
    },
    {
      "source": "/api/:path*",
      "destination": "https://aicte-compliance-backend-live.vercel.app/api/:path*"
    },
    {
      "source": "/docs",
      "destination": "https://aicte-compliance-backend-live.vercel.app/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://aicte-compliance-backend-live.vercel.app/openapi.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
