# =============================================================================
# AICTE Compliance AI — Central Environment Template
# =============================================================================
# Copy this file to:
#   - Root `.env` (or set environment variables in your local shell / Render dashboard)
#   - `frontend/app/.env.local` for local Vite development
#
# NEVER COMMIT REAL SECRET VALUES OR SERVICE-ROLE KEYS TO GIT!
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Supabase Platform Configuration (Shared)
# -----------------------------------------------------------------------------
# Required for Supabase Auth, PostgreSQL RLS, and Document Vault storage.
# Frontend uses Vite prefix VITE_SUPABASE_*, Backend uses SUPABASE_*.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_anon_key

# Frontend Vite equivalents (in frontend/app/.env.local):
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=sb_publishable_replace_with_anon_key

# -----------------------------------------------------------------------------
# 2. Backend API & Routing (Frontend Client)
# -----------------------------------------------------------------------------
# Base URL of the FastAPI backend. Leave empty for local same-origin proxy or
# set to your deployed backend URL.
# VITE_API_URL=https://aicte-compliance-backend-live.vercel.app

# -----------------------------------------------------------------------------
# 3. CORS & Allowed Origins (FastAPI Backend)
# -----------------------------------------------------------------------------
# Comma-separated list of deployed frontend origins permitted to call the backend.
# Local development origins (localhost:5173, 127.0.0.1:5173) are always permitted.
CORS_ALLOW_ORIGINS=https://aicte-compliance-ai.vercel.app

# -----------------------------------------------------------------------------
# 4. Optional Antivirus & OCR Engine Tuning (Backend)
# -----------------------------------------------------------------------------
# ClamAV daemon host and port (defaults to localhost:3310 if ClamAV daemon is installed).
# If ClamAV daemon is not reachable, the scanner safely returns advisory scan_unavailable.
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310

# Tesseract OCR language and maximum byte limits (defaults: eng, 10MB)
# TESSERACT_LANGUAGE=eng
# TESSERACT_MAX_BYTES=10485760

# -----------------------------------------------------------------------------
# 5. Deployment Diagnostics (Provided automatically by Vercel & Render)
# -----------------------------------------------------------------------------
# VERCEL_GIT_COMMIT_SHA=
# RENDER_GIT_COMMIT=
# ENVIRONMENT=production
