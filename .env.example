# Local configuration template — no real values.
#
# Supabase Auth and Postgres configuration for opt-in validation history.
# Supply these through the local process environment or deployment secret manager.
# Never add a service-role key to frontend or backend application configuration.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me

# Vite reads its own public values from frontend/app/.env.local.
# See frontend/app/.env.example. These values are publishable, not secret.

