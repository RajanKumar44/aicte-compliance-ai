{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix frontend/app run build",
  "installCommand": "npm --prefix frontend/app install",
  "outputDirectory": "frontend/app/dist",
  "rewrites": [
    {
      "source": "/health",
      "destination": "https://aicte-compliance-backend.onrender.com/health"
    },
    {
      "source": "/version",
      "destination": "https://aicte-compliance-backend.onrender.com/version"
    },
    {
      "source": "/api/:path*",
      "destination": "https://aicte-compliance-backend.onrender.com/api/:path*"
    },
    {
      "source": "/docs",
      "destination": "https://aicte-compliance-backend.onrender.com/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://aicte-compliance-backend.onrender.com/openapi.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
